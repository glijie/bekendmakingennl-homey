{
  "id": "com.patrick.bekendmakingennl",
  "version": "1.0.0",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Bekendmakingen NL",
    "nl": "Bekendmakingen NL"
  },
  "description": {
    "nl": "Ontdek wat er officieel wordt gepubliceerd rond de plekken die voor jou tellen.",
    "en": "Discover what is officially published around the places that matter to you."
  },
  "category": "tools",
  "brandColor": "#154273",
  "author": {
    "name": "Patrick"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "permissions": [],
  "tags": {
    "en": [
      "notices",
      "permits",
      "government",
      "neighbourhood",
      "Netherlands"
    ],
    "nl": [
      "bekendmakingen",
      "vergunningen",
      "overheid",
      "buurt",
      "Nederland"
    ]
  },
  "api": {
    "getMonitors": {
      "method": "GET",
      "path": "/monitors"
    },
    "getRecentNotices": {
      "method": "GET",
      "path": "/monitors/:id/notices"
    }
  },
  "source": "https://github.com/glijie/bekendmakingennl-homey",
  "support": "https://github.com/glijie/bekendmakingennl-homey"
}
