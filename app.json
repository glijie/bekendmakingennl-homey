          "hint": {
            "nl": "Bij wijzigen: vul ook het juiste adres of de gebiedsnaam in. Bij meerdere gelijknamige gebieden voeg je beter opnieuw toe.",
            "en": "When changing mode, enter the correct address or area name. Re-pair ambiguous areas."
          }
        },
        {
          "id": "address",
          "type": "text",
          "label": {
            "en": "Address",
            "nl": "Adres"
          },
          "value": "",
          "hint": {
            "en": "Full Dutch address, e.g. street, house number and city.",
            "nl": "Volledig Nederlands adres, bijvoorbeeld straat, huisnummer en woonplaats."
          },
          "highlight": true
        },
        {
          "id": "area_query",
          "type": "text",
          "label": {
            "nl": "Gebiedsnaam (niet voor adressen)",
            "en": "Area name (not for addresses)"
          },
          "value": "",
          "hint": {
            "nl": "Alleen voor stad, dorp, wijk, buurt of gemeente.",
            "en": "Only for town, city, district, neighborhood or municipality."
          }
        },
        {
          "id": "radius_m",
          "type": "number",
          "label": {
            "en": "Radius (address mode only)",
            "nl": "Afstand (alleen bij adres)"
          },
          "value": 1000,
          "units": {
            "en": "m",
            "nl": "m"
          },
          "hint": {
            "en": "Used only for Address + radius; area modes use the official geographic boundary.",
            "nl": "Alleen gebruikt bij Adres + afstand. Bij dorp, wijk, buurt of gemeente bepaalt de officiële gebiedsgrens de zoekopdracht."
