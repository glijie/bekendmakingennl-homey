          "min": 50,
          "max": 50000,
          "step": 50,
          "highlight": true
        },
        {
          "id": "check_interval_min",
          "type": "number",
          "label": {
            "en": "Check interval",
            "nl": "Controle-interval"
          },
          "value": 15,
          "units": {
            "en": "min",
            "nl": "min"
          },
          "hint": {
            "en": "How often Homey checks for new publications.",
            "nl": "Hoe vaak Homey controleert op nieuwe publicaties."
          },
          "min": 5,
          "max": 1440,
          "step": 5
        },
        {
          "type": "label",
          "label": {
            "nl": "Volledige bekendmakingen bekijken",
